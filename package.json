{
  "name": "@xstd/deep-map",
  "version": "1.4.0",
  "type": "module",
  "description": "A deep Map",
  "keywords": [
    "Deep map"
  ],
  "author": "Valentin Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xstd-js/deep-map.git"
  },
  "packageManager": "yarn@4.18.1",
  "main": "./index.js",
  "scripts": {
    "=== FB: BUILD ===": "",
    "fb:build": "fabrique build",
    "=== FB: TEST ===": "",
    "fb:test": "vitest run",
    "fb:test:coverage": "vitest run --coverage",
    "fb:bench": "vitest bench",
    "=== FB: CODE QUALITY ===": "",
    "fb:format": "yarn fb:format:fix",
    "fb:format:check": "prettier --check --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:format:fix": "prettier --write --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:check": "yarn fb:check:types && yarn fb:format:check",
    "fb:check:types": "tsc -p tsconfig.json --noEmit",
    "=== FB: RELEASE ===": "",
    "fb:manual:release": "fabrique release",
    "fb:ci:release": "fabrique ci release"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "fabrique": "2.0.27",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "access": "public",
  "fabrique": {
    "version": "2.0.27",
    "type": "lib"
  },
  "dependencies": {
    "@xstd/constructor-types": "^1.0.2"
  }
}
